# 인증키는 저장소에 올라가지 않는다. 각 줄의 = 뒤에만 값을 넣으면 된다.

# [1] 실시간 도착 — 서울 열린데이터광장 '지하철인증키'
#     https://data.seoul.go.kr/together/mypage/actkeyMain.do
#     '일반인증키'를 넣으면 ERROR-338로 거부한다.
SEOUL_SUBWAY_API_KEY=

# [2] 정기 시간표 — 공공데이터포털 '서울교통공사_열차시간표' 서비스키
#     https://apis.data.go.kr/B553766/schedule
#     포털이 인코딩/디코딩 두 가지를 주는데 '디코딩' 쪽을 넣는다.
#     (+ / = 같은 문자가 들어 있어도 그대로 붙여넣으면 된다 — 코드가 인코딩한다.)
SEOUL_SUBWAY2_API_KEY=

# [3] 서울 열린데이터광장 '일반인증키'. 현재 미사용 — 둘을 섞는 실수를 막으려 자리만 둔다.
SEOUL_OPEN_API_KEY=
